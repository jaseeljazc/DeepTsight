# Copy to .env.local for development. Never commit real values.
# NEXT_PUBLIC_ENV=production makes every variable below required and refuses Cloudflare test keys
# (src/lib/env-rules.ts, checked before every build by scripts/check-env.ts).

# Public client environment variables
# development | preview | production. Only "production" is indexed and hides unverified content.
NEXT_PUBLIC_ENV=development
# Canonical origin, no trailing slash. https required in production. Domain still to be decided.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Leave empty in development to use Cloudflare's always-pass test key.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Leave empty to load no analytics script (tool not yet agreed, OPEN-08).
NEXT_PUBLIC_ANALYTICS_DOMAIN=

# Server-only environment variables
# Leave empty in development to use Cloudflare's always-pass test secret.
TURNSTILE_SECRET_KEY=
# Leave empty in development: enquiries are then simulated, not sent.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=
# Leave empty in development to use the in-memory rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CMS (Payload). Read only by src/cms and scripts/cms. Never commit real values.
# static (default): content comes from src/content/source. cms: content comes from the database.
CONTENT_SOURCE=static
# PostgreSQL, role deeptsight_cms. Required when CONTENT_SOURCE=cms and on the live site.
# On the live site it must use sslmode=require or sslmode=verify-full unless the host is localhost.
DATABASE_URI=
# Development and tests only: the test and restore databases (names must end in _test / _restore).
DATABASE_URI_TEST=
DATABASE_URI_RESTORE=
# At least 32 random characters. Signs CMS sessions.
PAYLOAD_SECRET=
# 32 random bytes, base64. Encrypts TOTP secrets at rest.
MFA_ENCRYPTION_KEY=
# Days to keep enquiries in the CMS inbox. Empty: nothing is purged (decision pending, PRIV-09).
ENQUIRY_RETENTION_DAYS=
